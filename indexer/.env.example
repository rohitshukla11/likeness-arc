# Copy to indexer/.env (never committed).
# HyperSync API token (https://envio.dev/app/api-tokens), only if HyperSync serves Arc (chain 5042);
# without it, the indexer syncs from the RPC alone.
ENVIO_API_TOKEN=
# Optional overrides
# ENVIO_RPC_URL=https://rpc.mainnet.arc.io
# ENVIO_START_BLOCK=<CreatorRegistry creation block, from deployments/arc-mainnet.json>
