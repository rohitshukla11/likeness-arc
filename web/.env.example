# Copy to web/.env.local (never committed). Local-first: everything below runs on localhost.
# Deploying (see "Deploying" in the README): every *_FILE secret can be passed as its value
# instead (ATTESTER_PRIVATE_KEY, DRIP_PRIVATE_KEY, RENDER_AGENT_PRIVATE_KEY, C2PA_CERT_PEM, C2PA_KEY_PEM,
# DYNAMIC_DELEGATION_PRIVATE_KEY_PEM, DYNAMIC_AGENT_JSON). On Vercel, also STORE_DRIVER=blob.

# --- public (shipped to the browser) ---
# Dynamic sandbox environment ID (Dynamic dashboard > Developers > SDK & API keys).
# Add http://localhost:3000 to the environment's allowed origins.
NEXT_PUBLIC_DYNAMIC_ENV_ID=
# Passkey relying party. Keys are bound to it: localhost for local testing.
NEXT_PUBLIC_RP_ID=localhost
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io

# --- server only ---
# Storage for ciphertext, app records, renders and the RPC history cache: "local" (folders below, git-ignored)
# or "blob" (private Vercel Blob; then set BLOB_READ_WRITE_TOKEN). Use blob on Vercel.
STORE_DRIVER=local
STORE_DIR=.data/vault
# Gas top-up (native USDC) for new embedded wallets. Locally the key stays in its file; hosted, use DRIP_PRIVATE_KEY instead.
DRIP_KEY_FILE=../.secrets/drip.key
DRIP_AMOUNT_USDC=0.05
DRIP_PER_IP_PER_HOUR=3
DRIP_PER_HOUR=30

# --- Creator verification: Didit (https://docs.didit.me) ---
# API key from the Didit Business Console (a sandbox application's key labels creators "didit-sandbox").
DIDIT_API_KEY=
# Verification level:
#   free (default for now): Didit ID 18+ + PASSIVE liveness + selfie-to-ID face match (Didit's free tier),
#        and the three reference photos matched to the liveness selfie on this server (`pnpm face:models`).
#   full (for the live demo): ACTIVE liveness, and Didit's 1:1 face match for the photos. Needs Didit credit.
VERIFICATION_LEVEL=free
# Published Didit workflows, one per level: OCR (minimum_age 18, DECLINE), LIVENESS (PASSIVE | ACTIVE_3D), FACE_MATCH.
DIDIT_WORKFLOW_ID_FREE=
DIDIT_WORKFLOW_ID_FULL=
# Optional: the webhook destination's secret_shared_key. Without it the server polls Didit's decision API.
DIDIT_WEBHOOK_SECRET=
# full: Didit 1:1 face match, each reference photo vs the liveness selfie must score above this (0-100).
DIDIT_CAPTURE_MATCH_THRESHOLD=60
# free: local matcher (YuNet + AuraFace), cosine similarity threshold, and where its models live.
LOCAL_FACE_MATCH_THRESHOLD=0.55
FACE_MODELS_DIR=.models
# Public URL of this app, for Didit's redirect after verification (defaults to the request origin).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Platform attester (signs creator attestations). Locally the key stays in its file.
ATTESTER_KEY_FILE=../.secrets/attester.key

# --- Day 4: licensing, key release, delegation ---
# Chain reads on the server (defaults to NEXT_PUBLIC_ARC_RPC_URL). The demo points this at a local fork.
# ARC_RPC_URL=
# Off-chain app records (requests, briefs, delegation grants): local JSON under DB_DIR, or Vercel Blob.
DB_DIR=.data/db
# Render agent: signs LicenseEscrow Render attestations. Its address must be registered with
# LicenseEscrow.setRenderAgent (owner). Replaced by a Dynamic server wallet once DYNAMIC_API_KEY is set.
RENDER_AGENT_KEY_FILE=../.secrets/render-agent.key
# Dynamic server-side: environment API token, delegated-access webhook secret, and the RSA private key
# whose public half is registered under Embedded Wallets > Delegated Access.
DYNAMIC_API_KEY=
DYNAMIC_WEBHOOK_SECRET=
DYNAMIC_DELEGATION_PRIVATE_KEY_FILE=../.secrets/dynamic-delegation.pem
# Dev only: hide the Next.js dev overlay (issue toasts) while recording a demo. Real errors are hidden too.
NEXT_PUBLIC_HIDE_DEV_OVERLAY=0
# Dev only: seeded test wallets in the UI (header picker) and dev delegation for the seeded test brand.
DEV_WALLETS=0
DEV_DELEGATION=0
DEV_KEYS_DIR=../.secrets/dev
# Dynamic server wallet for the render agent: written by `pnpm agent:dynamic` (needs DYNAMIC_API_KEY).
DYNAMIC_AGENT_FILE=../.secrets/dynamic-agent.json

# --- Day 5: generation and receipts ---
# Google Gemini (https://aistudio.google.com → Get API key): renders from the creator's reference photos
# and the LLM prompt filter. Image models have no free tier: turn on billing for the key's project.
# Use a billed key for real creators either way: free-tier inputs may be used by Google and human-reviewed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=1K
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite
# Without the key: the DevRenderer makes a clearly marked TEST RENDER, and prompts are checked by
# local rules only ("LLM filter not configured").
# C2PA signing chain. `pnpm c2pa:testcert` makes a TEST chain here (not on the C2PA trust list).
C2PA_CERT_FILE=../.secrets/c2pa/signer.pem
C2PA_KEY_FILE=../.secrets/c2pa/signer.key
RENDERS_DIR=.data/renders
# Envio HyperIndex (../indexer). Either Hasura GraphQL, or the indexer's Postgres directly (`pnpm local`
# there runs without Docker). Unset: history comes from cached RPC log scans.
ENVIO_GRAPHQL_URL=
ENVIO_PG_URL=

# Public profile images are face-matched against all three attested photos (best score counts).
# Optional bar for an approved sample (default 0.45; a real photo uses LOCAL_FACE_MATCH_THRESHOLD above).
# SAMPLE_FACE_MATCH_THRESHOLD=0.45
